# The sweep (ADR-0015, item 6). Install: see phdcode-sweep.timer.
[Unit]
Description=phdcode sweep: run the saved searches and write the digest
After=network-online.target

[Service]
Type=oneshot
# The phdcode command of the Python environment where phdcode is installed.
# The sweep, then the PDF queue (its parses use the GPU while llama-server is
# stopped), then the pending summaries (they start llama-server through its
# socket). "-": the next step runs also if a step fails.
ExecStart=-%h/miniconda3/envs/alira/bin/phdcode sweep
ExecStart=-%h/miniconda3/envs/alira/bin/phdcode ingest
ExecStart=%h/miniconda3/envs/alira/bin/phdcode summarize
Nice=10
