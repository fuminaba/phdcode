# /etc/phdcode-replica/replica.env, root 0600, written by hand. Read by docker compose (--env-file) and sync.sh.
# The blob URL of the dump with a read-only SAS on that one blob (signed with the account key: a user delegation
# SAS lasts at most 7 days).
DUMP_URL=<https://<account>.blob.core.windows.net/<container>/<blob>?<sas>>
POSTGRES_PASSWORD=<a long random value: openssl rand -hex 24>
MCP_AUTH_URL=<a URL that answers 200 for a good bearer token>
MCP_HOSTS=<the public host name of the proxy>
